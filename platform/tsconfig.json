{
  "extends": "./tsconfig.base.json",
  "compilerOptions": { "jsx": "react-jsx", "noEmit": true },
  "include": [
    "tests/unit/**/*.ts",
    "tests/unit/**/*.tsx",
    "tests/**/*.d.ts",
    "tests/integration/**/*.ts",
    "tests/integration/**/*.tsx",
    "tests/browser/**/*.ts",
    "vitest.config.ts",
    "playwright.config.ts",
