{
  "name": "resume-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": "20.19.0",
    "pnpm": "10.28.2"
  },
  "scripts": {
    "dev": "pnpm --filter @resume/web dev",
    "build": "pnpm --filter @resume/web build",
    "lint": "eslint apps packages tests",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && pnpm -r --if-present typecheck",
    "boundaries:check": "depcruise --config .dependency-cruiser.cjs apps packages --output-type err",
    "contracts:generate": "tsx scripts/generate-resume-schema.ts",
    "contracts:check": "tsx scripts/generate-resume-schema.ts --check",
    "db:migrate": "node --env-file=.env.local --import tsx scripts/migrate.ts --database=dev",
    "db:migrate:test": "node --env-file=.env.local --import tsx scripts/migrate.ts --database=test",
    "db:seed:dev": "node --env-file=.env.local --import tsx scripts/seed-development.ts",
    "ops:restore:rehearse": "node --env-file=.env.local --import tsx scripts/ops/rehearse-logical-restore.ts --environment=test",
    "test:migrations": "node --env-file=.env.local ./node_modules/vitest/vitest.mjs run tests/integration/migrations.test.ts",
    "test:unit": "vitest run --dir tests/unit",
    "test:integration": "node --env-file=.env.local ./node_modules/vitest/vitest.mjs run --dir tests/integration",
    "perf:baseline": "tsx scripts/performance/renderer-baseline.ts --environment local --budget performance-budget.json",
    "ci:fast": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm boundaries:check && pnpm contracts:check && pnpm test:unit",
    "test:save": "pnpm --filter @resume/save-reliability test",
    "test:save:unit": "pnpm --filter @resume/save-reliability test:unit",
    "test:save:pg": "pnpm --filter @resume/save-reliability test:pg"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@resume/application": "workspace:*",
    "@resume/config": "workspace:*",
    "@resume/domain": "workspace:*",
    "@resume/infrastructure": "workspace:*",
    "@resume/resume-renderer": "workspace:*",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dependency-cruiser": "17.4.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.5",
    "fake-indexeddb": "6.2.5",
    "jsdom": "27.0.0",
    "prettier": "3.9.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.0",
    "vitest": "5.0.1",
    "zod": "4.6.5"
  }
}
