{
  "schemaVersion": 1,
  "productVersion": "V0.2",
  "status": "engineering-baseline",
  "description": "内部工程验收基线，不是对外 SLA；浏览器与保存 API 指标必须由对应环境报告验证。",
  "metrics": {
    "rendererProjection": {
      "unit": "ms",
      "minimumSamples": 50,
      "p95Max": 100
    },
    "pagination": {
      "unit": "ms",
      "minimumSamples": 50,
      "p95Max": 500
    },
    "fieldToPreview": {
      "unit": "ms",
      "minimumSamples": 50,
      "p95Max": 100,
      "requires": "desktop-chromium"
    },
    "localDraftCommit": {
      "unit": "ms",
      "minimumSamples": 50,
      "p95Max": 400,
      "requires": "indexeddb-browser"
    },
    "saveApi": {
      "unit": "ms",
      "minimumSamples": 300,
      "p95Max": 500,
      "p99Max": 1000,
      "unexpectedFailureRateMax": 0.001,
      "requires": "isolated-perf-environment"
    },
    "inputToCloudAck": {
      "unit": "ms",
      "minimumSamples": 50,
      "p95Max": 2000,
      "requires": "reference-network-rtt-lte-100ms"
    },
    "resumeListApi": {
      "unit": "ms",
      "minimumSamples": 300,
      "p95Max": 300,
      "requires": "100-synthetic-resumes-real-session"
    },
    "resumeCrudApi": {
      "unit": "ms",
      "minimumSamples": 300,
      "p95Max": 500,
      "requires": "same-region-real-session"
    },
    "dashboardFirstRender": {
      "unit": "ms",
      "minimumSamples": 50,
      "p95Max": 1500,
      "requires": "production-build-desktop-chrome"
    }
  }
}
